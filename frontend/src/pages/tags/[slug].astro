---
export const prerender = false;

import { detectLanguage } from "../../lib/i18n";

const redirectPath = `/${detectLanguage(
  Astro.cookies,
  Astro.request.headers.get("accept-language"),
)}/tags/${Astro.params.slug ?? ""}${Astro.url.search}`;

void redirectPath;
return Astro.redirect(redirectPath, 302);
---
